#!/usr/bin/env python
import numpy as np
import argparse
from sklearn.model_selection import train_test_split
import os

def split_npz_file(input_npz_path, test_fraction, random_seed=42):
    """
    Splits the data from an NPZ file into two separate NPZ files:
    one for training/validation and one for testing.

    Args:
        input_npz_path (str): Path to the input NPZ file.
        test_fraction (float): Fraction of the data to allocate to the test set.
        random_seed (int): Random seed for reproducibility of the split.
    """
    train_val_out_path = input_npz_path.replace(".npz", "_train_val.npz")
    test_out_path = input_npz_path.replace(".npz", "_test.npz")

    print(f"Loading data from {input_npz_path}...")
    try:
        data = np.load(input_npz_path)
    except FileNotFoundError:
        print(f"Error: Input NPZ file not found at {input_npz_path}")
        return
    except Exception as e:
        print(f"Error loading NPZ file {input_npz_path}: {e}")
        return

    keys = list(data.keys())
    if not keys:
        print(f"Error: No data arrays found in {input_npz_path}")
        return

    # Assume all arrays share the first dimension as the number of samples
    try:
        num_samples = data[keys[0]].shape[0]
        # Verify all arrays have the same number of samples
        for key in keys:
            if data[key].shape[0] != num_samples:
                print(f"Error: Array '{key}' has {data[key].shape[0]} samples, but expected {num_samples} samples based on array '{keys[0]}'.")
                return
    except IndexError: # If an array is 0-dimensional or less than 1-dimensional
        print(f"Error: Could not determine number of samples from array '{keys[0]}'. Ensure data arrays are at least 1D.")
        return


    indices = np.arange(num_samples)

    print(f"Splitting {num_samples} samples. Test fraction: {test_fraction}, Random seed: {random_seed}")
    train_val_indices, test_indices = train_test_split(
        indices, test_size=test_fraction, shuffle=True, random_state=random_seed
    )

    train_val_data_dict = {}
    test_data_dict = {}

    for key in keys:
        train_val_data_dict[key] = data[key][train_val_indices]
        test_data_dict[key] = data[key][test_indices]

    # Ensure output directories exist
    for out_path in [train_val_out_path, test_out_path]:
        out_dir = os.path.dirname(out_path)
        if out_dir: # Only create if dirname is not empty (i.e., not saving in current dir)
            os.makedirs(out_dir, exist_ok=True)

    try:
        print(f"Saving train/validation data to {train_val_out_path} ({len(train_val_indices)} samples)")
        np.savez(train_val_out_path, **train_val_data_dict)

        print(f"Saving test data to {test_out_path} ({len(test_indices)} samples)")
        np.savez(test_out_path, **test_data_dict)
    except Exception as e:
        print(f"Error saving NPZ files: {e}")
        return

    print(f"NPZ splitting complete for {input_npz_path}.")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Split an NPZ file into train/validation and test sets, preserving all internal arrays."
    )
    parser.add_argument("input_npz", help="Path to the input NPZ file.")
    parser.add_argument("test_fraction", type=float, help="Fraction of data to allocate to the test set (e.g., 0.2 for 20%).")
    parser.add_argument("--random_seed", type=int, default=42, help="Random seed for shuffling before splitting.")

    args = parser.parse_args()

    if not 0 < args.test_fraction < 1:
        print("Error: test_fraction must be between 0 and 1 (exclusive).")
    else:
        split_npz_file(args.input_npz, args.test_fraction, args.random_seed)
